    "@tauri-apps/plugin-http": "^0.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "zustand": "^4.4.1",
    "axios": "^1.6.2",
    "clsx": "^2.0.0",
    "tailwindcss": "^3.4.0",
    "lucide-react": "^0.294.0",
    "recharts": "^2.10.3",
    "react-hot-toast": "^2.4.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^1.5.8",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
