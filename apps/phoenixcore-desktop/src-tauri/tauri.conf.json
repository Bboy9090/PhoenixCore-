{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dashboard:install && npm --prefix ../../dashboard run dev -- --host 127.0.0.1 --port 1421",
    "devPath": "http://127.0.0.1:1421",
    "distDir": "../../../dashboard/dist"
  },
  "package": {
    "productName": "PhoenixCore Desktop",
    "version": "0.1.1"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "execute": false,
        "open": false,
        "sidecar": false
      }
    },
    "bundle": {
      "active": true,
      "category": "Utility",
      "copyright": "Copyright © 2026 Bobby's World",
      "identifier": "com.bobbysworld.phoenixcore.desktop",
      "icon": [
        "../../phoenix-key/src-tauri/icons/32x32.png",
        "../../phoenix-key/src-tauri/icons/128x128.png",
        "../../phoenix-key/src-tauri/icons/128x128@2x.png",
        "../../phoenix-key/src-tauri/icons/icon.ico"
      ],
      "longDescription": "PhoenixCore desktop dashboard packaged as a native Tauri application.",
      "shortDescription": "PhoenixCore Desktop",
      "targets": ["msi", "nsis"],
      "windows": {
        "webviewInstallMode": {
          "type": "downloadBootstrapper",
          "silent": true
        }
      }
    },
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "center": true,
        "fullscreen": false,
        "height": 900,
        "minHeight": 720,
        "minWidth": 1040,
        "resizable": true,
        "title": "PhoenixCore Desktop",
        "width": 1440
      }
    ]
  }
}
