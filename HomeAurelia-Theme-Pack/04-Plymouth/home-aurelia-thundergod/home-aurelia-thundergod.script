# Home Aurelia — Plymouth Boot Theme
#
# Form-aware background tones
screen_width  = Window.GetWidth();
screen_height = Window.GetHeight();

# Deep Navy: 0.031, 0.078, 0.149; Obsidian Black: 0.020, 0.027, 0.051
Window.SetBackgroundTopColor(0.031, 0.078, 0.149);
Window.SetBackgroundBottomColor(0.020, 0.027, 0.051);

# Edition splash backdrop
splash_image = Image("splash.png");
scaled_splash_image = splash_image.Scale(screen_width, screen_height);
splash_sprite = Sprite(scaled_splash_image);
splash_sprite.SetPosition(0, 0, 0);
splash_sprite.SetOpacity(0.20);

# Core visual assets
logo_image = Image("logo.png");
bar_bg_image = Image("progress-box.png");
bar_fill_image = Image("progress-bar.png");

# Logo sprite
logo_sprite = Sprite(logo_image);
logo_x = (screen_width - logo_image.GetWidth()) / 2;
logo_y = (screen_height - logo_image.GetHeight()) / 2 - 70;
logo_sprite.SetPosition(logo_x, logo_y, 1);
logo_sprite.SetOpacity(0);

# Progress bar geometry
progress_bar_height = 6;
progress_bar_y = screen_height - 80;
progress_bar_max_width = screen_width * 0.46;
progress_bar_x_start = (screen_width - progress_bar_max_width) / 2;

scaled_bg_image = bar_bg_image.Scale(progress_bar_max_width, progress_bar_height);
bar_bg_sprite = Sprite(scaled_bg_image);
bar_bg_sprite.SetPosition(progress_bar_x_start, progress_bar_y, 1);

scaled_fill_image = bar_fill_image.Scale(2, progress_bar_height);
bar_fill_sprite = Sprite(scaled_fill_image);
bar_fill_sprite.SetPosition(progress_bar_x_start, progress_bar_y, 2);

frame = 0;
logo_fade_in_frames = 28;

fun refresh_callback() {
    frame++;

    if (frame <= logo_fade_in_frames) {
        opacity = frame / logo_fade_in_frames;
        logo_sprite.SetOpacity(opacity);
    } else {
        logo_sprite.SetOpacity(1.0);
    }

    boot_progress = Plymouth.GetBootProgress();
    if (boot_progress < 0) {
        boot_progress = 0;
    }
    if (boot_progress > 1) {
        boot_progress = 1;
    }

    current_width = progress_bar_max_width * boot_progress;
    if (current_width < 2) {
        current_width = 2;
    }

    scaled_fill_image = bar_fill_image.Scale(current_width, progress_bar_height);
    bar_fill_sprite.SetImage(scaled_fill_image);
}

Plymouth.SetRefreshFunction(refresh_callback);

fun message_callback(text) {
    # Quiet splash; keep boot logs hidden unless debug mode is enabled.
}

Plymouth.SetMessageFunction(message_callback);

fun quit_callback() {
    logo_sprite.SetOpacity(0);
}

Plymouth.SetQuitFunction(quit_callback);
