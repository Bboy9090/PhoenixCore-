root = true

# PhoenixCore / Phoenix Platform baseline editor policy.
# This file belongs to the repository root and must not be treated as a
# dependency-package file. Keep it broad and conservative until PR 3 settles
# the monorepo layout.

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.rs]
indent_style = space
indent_size = 4

[*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css,html,yml,yaml,toml}]
indent_style = space
indent_size = 2

[*.{bat,cmd,ps1}]
end_of_line = crlf
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{sh,command}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
