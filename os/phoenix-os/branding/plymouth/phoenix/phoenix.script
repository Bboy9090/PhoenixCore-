# Blue Phoenix OS — Plymouth Boot Theme
screen_width  = Window.GetWidth();
screen_height = Window.GetHeight();

Window.SetBackgroundTopColor(0.01, 0.02, 0.05);
Window.SetBackgroundBottomColor(0.01, 0.02, 0.05);

# Splash Image (The Sovereign Bird)
splash_image = Image("splash-background.png");
scaled_splash_image = splash_image.Scale(screen_width, screen_height);
splash_sprite = Sprite(scaled_splash_image);
splash_sprite.SetPosition(0, 0, 0);
splash_sprite.SetOpacity(1.0);

# Progress Bar Setup
bar_bg_image = Image("progress-bg.png");
bar_fill_image = Image("progress-fill.png");

# Scale the 1x1 pixel dynamically to a 600x6 progress bar
scaled_width = 600;
scaled_height = 6;
bar_bg_scaled = bar_bg_image.Scale(scaled_width, scaled_height);
bar_fill_scaled = bar_fill_image.Scale(scaled_width, scaled_height);

bar_width = bar_bg_scaled.GetWidth();
bar_height = bar_bg_scaled.GetHeight();
bar_x = (screen_width / 2) - (bar_width / 2);
bar_y = (screen_height / 2) + 200; # 200px below center

bar_bg_sprite = Sprite(bar_bg_scaled);
bar_bg_sprite.SetPosition(bar_x, bar_y, 1);

bar_fill_sprite = Sprite();
bar_fill_sprite.SetPosition(bar_x, bar_y, 2);

fun refresh_callback() {
    # Move the progress bar from Left to Right flawlessly
    boot_progress = Plymouth.GetBootProgress();
    
    # Calculate how much of the bar is filled
    fill_width = bar_width * boot_progress;
    
    # Crop the fill image from left to right
    if (fill_width > 0) {
        cropped_fill = bar_fill_scaled.Crop(0, 0, fill_width, bar_height);
        bar_fill_sprite.SetImage(cropped_fill);
    }
}

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetMessageFunction(fun(text) { });
Plymouth.SetQuitFunction(fun() { });
