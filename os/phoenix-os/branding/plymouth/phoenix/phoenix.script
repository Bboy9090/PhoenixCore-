# Blue Phoenix OS — Plymouth Boot Theme (Edition Template)
#
# This template is patched at staging-time by scripts/build-edition.sh:
#   __BG_TOP_R__ __BG_TOP_G__ __BG_TOP_B__
#   __BG_BOT_R__ __BG_BOT_G__ __BG_BOT_B__

screen_width  = Window.GetWidth();
screen_height = Window.GetHeight();

# Edition-aware background tones
Window.SetBackgroundTopColor(__BG_TOP_R__, __BG_TOP_G__, __BG_TOP_B__);
Window.SetBackgroundBottomColor(__BG_BOT_R__, __BG_BOT_G__, __BG_BOT_B__);

# Edition splash backdrop (staged as splash-background.png)
# This is our pre-rendered minimal cosmic galaxy + Phoenix loader image
splash_image = Image("splash-background.png");
scaled_splash_image = splash_image.Scale(screen_width, screen_height);
splash_sprite = Sprite(scaled_splash_image);
splash_sprite.SetPosition(0, 0, 0);
splash_sprite.SetOpacity(1.0); # Solid 100% opacity for minimal splash loader

# The user's provided background images already contain the progress bar UI baked in.
# We will completely disable Plymouth's native progress bar drawing so it doesn't clash.
# bar_bg_image = Image("progress-bg.png");
# bar_fill_image = Image("progress-fill.png");

# scaled_fill_image = bar_fill_image.Scale(2, progress_bar_height);
# bar_fill_sprite = Sprite(scaled_fill_image);
# bar_fill_sprite.SetPosition(progress_bar_x_start, progress_bar_y, 2);

frame = 0;
logo_fade_in_frames = 28;

fun refresh_callback() {
    frame++;

    # Native progress bar update disabled because UI is baked into the splash image.
    # boot_progress = Plymouth.GetBootProgress();
    # ...
}

Plymouth.SetRefreshFunction(refresh_callback);

fun message_callback(text) {
    # Quiet splash; keep boot logs hidden unless debug mode is enabled.
}

Plymouth.SetMessageFunction(message_callback);

fun quit_callback() {
    # Fade out happens natively in Plymouth 0.9+
}

Plymouth.SetQuitFunction(quit_callback);
