#!/usr/bin/env python3
"""
Arcwyre Flex OS — Recovery Center
Status: STUBBED — Phase 6 implementation placeholder

The Recovery Center provides:
  - System info display
  - Disk health check (smartctl)
  - Network connectivity check
  - Boot repair notes
  - Log export
  - Safe cleanup
  - Reset user settings
  - Create recovery USB (future)

No fake actions. Every action either works or reports honestly why it doesn't.
"""

import subprocess
import sys
import os
import shutil

def check_tool(name):
    """Check if a system tool is available."""
    return shutil.which(name) is not None

def get_system_info():
    """Gather basic system information."""
    info = {}
    try:
        result = subprocess.run(['uname', '-r'], capture_output=True, text=True)
        info['kernel'] = result.stdout.strip()
    except Exception:
        info['kernel'] = 'unknown'
    try:
        result = subprocess.run(['free', '-h'], capture_output=True, text=True)
        info['memory'] = result.stdout.strip()
    except Exception:
        info['memory'] = 'unknown'
    try:
        result = subprocess.run(['df', '-h', '/'], capture_output=True, text=True)
        info['disk'] = result.stdout.strip()
    except Exception:
        info['disk'] = 'unknown'
    return info

def check_disk_health(device='/dev/sda'):
    """Check disk health using smartctl."""
    if not check_tool('smartctl'):
        return "NOT_RUN_ENVIRONMENT_LIMITATION — smartctl not found. Install: sudo apt-get install smartmontools"
    try:
        result = subprocess.run(
            ['smartctl', '-H', device],
            capture_output=True, text=True, timeout=10
        )
        return result.stdout.strip()
    except subprocess.TimeoutExpired:
        return "TIMEOUT — disk health check timed out"
    except Exception as e:
        return f"ERROR — {e}"

def check_network():
    """Check network connectivity."""
    try:
        result = subprocess.run(
            ['ping', '-c', '3', '-W', '2', '8.8.8.8'],
            capture_output=True, text=True, timeout=15
        )
        if result.returncode == 0:
            return "PASS — Network connectivity confirmed (8.8.8.8 reachable)"
        else:
            return "FAIL — Cannot reach 8.8.8.8. Check network settings."
    except Exception as e:
        return f"ERROR — {e}"

def export_logs(output_dir='/tmp/arcwyre-logs'):
    """Export system logs for diagnostics."""
    os.makedirs(output_dir, exist_ok=True)
    logs_to_export = [
        ('/var/log/syslog', 'syslog.txt'),
        ('/var/log/dmesg', 'dmesg.txt'),
        ('/var/log/Xorg.0.log', 'xorg.txt'),
    ]
    exported = []
    for src, dst in logs_to_export:
        if os.path.exists(src):
            try:
                shutil.copy2(src, os.path.join(output_dir, dst))
                exported.append(dst)
            except Exception as e:
                exported.append(f"{dst} — ERROR: {e}")
        else:
            exported.append(f"{dst} — NOT_FOUND")
    return output_dir, exported

def main():
    print("=== Arcwyre Flex OS — Recovery Center ===")
    print("Status: STUBBED — basic diagnostics only\n")

    if len(sys.argv) < 2:
        print("Usage: recovery-center.py <action>")
        print("Actions:")
        print("  sysinfo     — Show system information")
        print("  disk-health — Check disk health")
        print("  network     — Check network connectivity")
        print("  export-logs — Export system logs")
        return

    action = sys.argv[1]

    if action == 'sysinfo':
        info = get_system_info()
        print("System Information:")
        for k, v in info.items():
            print(f"  {k}:\n{v}\n")

    elif action == 'disk-health':
        device = sys.argv[2] if len(sys.argv) > 2 else '/dev/sda'
        print(f"Disk Health ({device}):")
        print(check_disk_health(device))

    elif action == 'network':
        print("Network Check:")
        print(check_network())

    elif action == 'export-logs':
        output_dir, exported = export_logs()
        print(f"Logs exported to: {output_dir}")
        for f in exported:
            print(f"  {f}")

    else:
        print(f"Unknown action: {action}")

if __name__ == '__main__':
    main()
