# Phoenix OS - Flagship Gaming Edition Packages
# This manifest ensures out-of-the-box flawlessly playing of PC games.

# 1. Wine Layer (Windows Compatibility)
wine
wine32
wine64
libwine
libwine:i386
winetricks

# 2. Vulkan Translation
mesa-vulkan-drivers
mesa-vulkan-drivers:i386
vulkan-tools
libvulkan1
libvulkan1:i386

# 3. Core 32-bit Libraries for Legacy Windows Titles
libgl1-mesa-dri:i386
libgl1-mesa-glx:i386
libc6:i386
