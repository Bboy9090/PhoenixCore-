#!/bin/sh
set -eu

# Unified root observer hook.
# Installs one deterministic root-level systemd service that watches
# actual KDE Plasma processes coexisting for a stable window and writes truthful markers.

mkdir -p /usr/local/sbin
mkdir -p /etc/systemd/system/graphical.target.wants

cat > /usr/local/sbin/bwos-desktop-observer <<'EOF2'
#!/bin/sh
set -eu

LIVE_USER="phoenix"
WALLPAPER="/usr/share/images/desktop-base/desktop-background.png"
USER_HOME="/home/${LIVE_USER}"
USER_CONFIG="${USER_HOME}/.config/plasma-org.kde.plasma.desktop-appletsrc"
PRESENTATION_JSON="/etc/bwos/presentation-layer.json"
PRESENTATION_LOCK="/usr/share/bwos/presentation/home-aurelia.lock"
WAIT_SECONDS="${BWOS_OBSERVER_WAIT_SECONDS:-240}"

serial_log() {
    ( printf '%s\n' "$*" > /dev/ttyS0 ) 2>/dev/null || true
    logger -t BWOS-SESSION "$*" >/dev/null 2>&1 || true
}

case "$WAIT_SECONDS" in
    ''|*[!0-9]*) WAIT_SECONDS=240 ;;
esac

process_env() {
    pid="$1"
    [ -r "/proc/${pid}/environ" ] || return 0
    tr '\0' '\n' < "/proc/${pid}/environ" 2>/dev/null | while IFS= read -r env_line; do
        case "$env_line" in
            DISPLAY=*|WAYLAND_DISPLAY=*|XDG_RUNTIME_DIR=*|DBUS_SESSION_BUS_ADDRESS=*|XDG_SESSION_TYPE=*) printf '%s\n' "$env_line" ;;
        esac
    done
}

apply_wallpaper_as_user() {
    plasma_pid="$1"
    env_file="/run/bwos-plasma-env"
    process_env "$plasma_pid" > "$env_file" || true
    chmod 0644 "$env_file" || true

    if [ -f "$WALLPAPER" ] && command -v runuser >/dev/null 2>&1; then
        env_args="$(awk '{ printf " %s", $0 }' "$env_file" 2>/dev/null || true)"
        if command -v plasma-apply-wallpaperimage >/dev/null 2>&1; then
            # shellcheck disable=SC2086
            timeout 8s runuser -u "$LIVE_USER" -- env $env_args plasma-apply-wallpaperimage "$WALLPAPER" >/dev/null 2>&1 || true
        fi
    fi

    mkdir -p "$(dirname "$USER_CONFIG")" >/dev/null 2>&1 || true
    cat > "$USER_CONFIG" <<EOF_CONFIG
[Containments][1]
wallpaperplugin=org.kde.image

[Containments][1][Wallpaper][org.kde.image][General]
Image=file://${WALLPAPER}
EOF_CONFIG
    chown "$LIVE_USER:$LIVE_USER" "$USER_CONFIG" >/dev/null 2>&1 || true
}

serial_log "BWOS_DESKTOP_OBSERVER_STARTED wait_seconds=${WAIT_SECONDS}"

kwin_pid=""
plasma_pid=""
ksm_pid=""
attempt=0
stable_seconds=5
current_stable=0

while [ "$attempt" -lt "$WAIT_SECONDS" ]; do
    # 1. Wait for phoenix user session via loginctl or user processes
    session_id="$(loginctl list-sessions --no-legend 2>/dev/null | awk -v user="$LIVE_USER" '$3 == user { print $1; exit }' || true)"

    # 2. Watch target processes coexisting
    kwin_pid="$(pgrep -u "$LIVE_USER" -x kwin_x11 2>/dev/null | head -n 1 || true)"
    plasma_pid="$(pgrep -u "$LIVE_USER" -x plasmashell 2>/dev/null | head -n 1 || true)"
    ksm_pid="$(pgrep -u "$LIVE_USER" -x ksmserver 2>/dev/null | head -n 1 || true)"

    if [ -n "$session_id" ] && [ -n "$kwin_pid" ] && [ -n "$plasma_pid" ] && [ -n "$ksm_pid" ]; then
        # 3. Confirm X11 session type
        session_type="$(loginctl show-session "$session_id" -p Type --value 2>/dev/null || true)"
        if [ "$session_type" = "x11" ] || process_env "$plasma_pid" | grep -q "XDG_SESSION_TYPE=x11"; then
            current_stable=$((current_stable + 1))
            serial_log "BWOS_OBSERVER_STABILITY_CHECK stable_seconds=${current_stable}/${stable_seconds}"
            if [ "$current_stable" -ge "$stable_seconds" ]; then
                break
            fi
        else
            current_stable=0
        fi
    else
        current_stable=0
    fi
    attempt=$((attempt + 1))
    sleep 1
done

# Re-read processes and session to make sure co-existence is maintained at confirmation time
session_id="$(loginctl list-sessions --no-legend 2>/dev/null | awk -v user="$LIVE_USER" '$3 == user { print $1; exit }' || true)"
kwin_pid="$(pgrep -u "$LIVE_USER" -x kwin_x11 2>/dev/null | head -n 1 || true)"
plasma_pid="$(pgrep -u "$LIVE_USER" -x plasmashell 2>/dev/null | head -n 1 || true)"
ksm_pid="$(pgrep -u "$LIVE_USER" -x ksmserver 2>/dev/null | head -n 1 || true)"

if [ -n "$session_id" ] && [ -n "$kwin_pid" ] && [ -n "$plasma_pid" ] && [ -n "$ksm_pid" ] && [ "$current_stable" -ge "$stable_seconds" ]; then
    # We co-verified X11, kwin_x11, plasmashell, ksmserver coexist and are stable!
    serial_log "BWOS_KWIN_STARTED"
    serial_log "BWOS_KSMSERVER_STARTED"
    serial_log "BWOS_PLASMASHELL_STARTED"

    # Emit desktop session started marker
    printf '%s\n' "BWOS_DESKTOP_SESSION_STARTED" > /run/bwos-desktop-reached
    serial_log "BWOS_DESKTOP_SESSION_STARTED"

    # Apply wallpaper
    apply_wallpaper_as_user "$plasma_pid"

    # Emit wallpaper applied marker if wallpaper exists and config matches
    if [ -f "$WALLPAPER" ] && [ -f "$USER_CONFIG" ] && grep -Fq "$WALLPAPER" "$USER_CONFIG"; then
        printf '%s\n' "BWOS_WALLPAPER_APPLIED" > /run/bwos-wallpaper-applied
        serial_log "BWOS_WALLPAPER_APPLIED"
    fi

    # Emit presentation lock active marker if the lock files co-exist
    if [ -f "$PRESENTATION_JSON" ] && [ -f "$PRESENTATION_LOCK" ]; then
        printf '%s\n' "BWOS_PRESENTATION_LOCK_ACTIVE" > /run/bwos-presentation-lock-active
        serial_log "BWOS_PRESENTATION_LOCK_ACTIVE"
    fi

    # Check for VM poweroff probe
    CMDLINE="$(cat /proc/cmdline 2>/dev/null || true)"
    serial_log "BWOS_KERNEL_CMDLINE ${CMDLINE}"
    case " ${CMDLINE} " in
        *" bwos.shutdown_probe=1 "*)
            serial_log "BWOS_SHUTDOWN_PROBE_REQUESTED"
            sleep 3
            serial_log "BWOS_SHUTDOWN_PROBE_SYSTEMCTL_POWEROFF_REQUEST"
            systemctl poweroff >/dev/null 2>&1 || poweroff >/dev/null 2>&1 || true
            ;;
    esac
else
    [ -n "$kwin_pid" ] && serial_log "BWOS_KWIN_STARTED" || serial_log "BWOS_KWIN_NOT_OBSERVED"
    [ -n "$ksm_pid" ] && serial_log "BWOS_KSMSERVER_STARTED" || serial_log "BWOS_KSMSERVER_NOT_OBSERVED"
    [ -n "$plasma_pid" ] && serial_log "BWOS_PLASMASHELL_STARTED" || serial_log "BWOS_PLASMASHELL_NOT_OBSERVED"
    serial_log "BWOS_DESKTOP_SESSION_NOT_CONFIRMED"
fi
EOF2
chmod 0755 /usr/local/sbin/bwos-desktop-observer

cat > /etc/systemd/system/bwos-desktop-observer.service <<'EOF2'
[Unit]
Description=BWOS Desktop Observer
After=sddm.service graphical.target
Wants=sddm.service

[Service]
Type=oneshot
Environment=BWOS_OBSERVER_WAIT_SECONDS=240
ExecStart=/usr/local/sbin/bwos-desktop-observer
TimeoutStartSec=300

[Install]
WantedBy=graphical.target
EOF2
ln -sf ../bwos-desktop-observer.service /etc/systemd/system/graphical.target.wants/bwos-desktop-observer.service
