#!/bin/sh
set -eu

install -d -m 0755 /usr/local/bin
install -d -m 0755 /etc/systemd/system

cat > /usr/local/bin/bwos-session-log <<'EOF2'
#!/bin/sh
set -eu

MESSAGE="$*"
printf '%s\n' "$MESSAGE" > /dev/ttyS0 2>/dev/null || true
logger -t BWOS-SESSION "$MESSAGE" >/dev/null 2>&1 || true
EOF2
chmod 0755 /usr/local/bin/bwos-session-log

cat > /usr/local/bin/bwos-session-profile-apply <<'EOF2'
#!/bin/sh
set -eu

LOG_FILE="/run/arcwyre-flex-session-profile.log"
LOG_TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')

# Logging function: write to file and journal
log_info() {
    MSG="[${LOG_TIMESTAMP}] [INFO] $*"
    echo "$MSG" >> "$LOG_FILE"
    logger -t bwos-session-profile -p info "$MSG" 2>/dev/null || true
}

log_success() {
    MSG="[${LOG_TIMESTAMP}] [SUCCESS] $*"
    echo "$MSG" >> "$LOG_FILE"
    logger -t bwos-session-profile -p info "$MSG" 2>/dev/null || true
}

log_fail() {
    MSG="[${LOG_TIMESTAMP}] [FAIL] $*"
    echo "$MSG" >> "$LOG_FILE"
    logger -t bwos-session-profile -p err "$MSG" 2>/dev/null || true
}

# Initialize log file
{
    echo "[${LOG_TIMESTAMP}] ARCWYRE Flex SDDM Autologin Profile Apply - START"
} >> "$LOG_FILE"

# Detect live user
LIVE_USER="phoenix"
if id -u arc >/dev/null 2>&1; then
    LIVE_USER="arc"
fi
log_info "Detected live user: $LIVE_USER"

# Get home directory
LIVE_HOME="/home/${LIVE_USER}"
log_info "Live home directory: $LIVE_HOME"

# Find X11 session
X11_SESSION=""
for candidate in \
    /usr/share/xsessions/plasmax11.desktop \
    /usr/share/xsessions/plasma.desktop \
    /usr/share/xsessions/xfce.desktop
do
    if [ -f "$candidate" ]; then
        X11_SESSION="$(basename "$candidate")"
        break
    fi
done
log_info "Detected X11 session: ${X11_SESSION:-NONE}"

# Find Wayland session
WAYLAND_SESSION=""
for candidate in \
    /usr/share/wayland-sessions/plasmawayland.desktop \
    /usr/share/wayland-sessions/plasma.desktop \
    /usr/share/wayland-sessions/xfce-wayland.desktop
do
    if [ -f "$candidate" ]; then
        WAYLAND_SESSION="$(basename "$candidate")"
        break
    fi
done
log_info "Detected Wayland session: ${WAYLAND_SESSION:-NONE}"

# Choose session (prefer X11)
SELECTED_SESSION="${X11_SESSION:-${WAYLAND_SESSION:-}}"
log_info "Chosen session: ${SELECTED_SESSION:-EMPTY}"

# FAIL if no session found
if [ -z "$SELECTED_SESSION" ]; then
    log_fail "ARCWYRE_FLEX_SDDM_SESSION_EMPTY_FAIL - no valid session found"
    echo "[${LOG_TIMESTAMP}] ARCWYRE Flex SDDM Profile Apply - END (FAILED)" >> "$LOG_FILE"
    exit 1
fi

# Remove stale conf.d autologin configs
if [ -f /etc/sddm.conf.d/autologin.conf ]; then
    log_info "Removing stale /etc/sddm.conf.d/autologin.conf"
    rm -f /etc/sddm.conf.d/autologin.conf
fi

# Create directories
install -d -m 0755 /etc/sddm.conf.d /run

# Write final SDDM autologin config to /etc/sddm.conf (highest precedence)
cat > /etc/sddm.conf <<EOF_CONF
[Autologin]
User=$LIVE_USER
Session=$SELECTED_SESSION
Relogin=true

[General]
DefaultSession=$SELECTED_SESSION

[Theme]
Current=phoenix
EOF_CONF

log_info "Wrote /etc/sddm.conf with User=$LIVE_USER Session=$SELECTED_SESSION"

# Log final config contents
{
    echo "[INFO] Final /etc/sddm.conf contents:"
    cat /etc/sddm.conf | sed 's/^/  /'
} >> "$LOG_FILE"

# Emit success marker
log_success "ARCWYRE_FLEX_SDDM_AUTOLOGIN_CONFIGURED user=$LIVE_USER session=$SELECTED_SESSION"
echo "[${LOG_TIMESTAMP}] ARCWYRE Flex SDDM Profile Apply - END (SUCCESS)" >> "$LOG_FILE"
EOF2
chmod 0755 /usr/local/bin/bwos-session-profile-apply

cat > /usr/local/bin/bwos-session-diagnostics-dump <<'EOF2'
#!/bin/sh
set -eu

LIVE_USER="phoenix"
if id -u arc >/dev/null 2>&1; then
    LIVE_USER="arc"
fi

log() {
    /usr/local/bin/bwos-session-log "$@"
}

emit_process_marker() {
    label="$1"
    pattern="$2"
    if pgrep -x "$pattern" >/dev/null 2>&1; then
        log "BWOS_PROC_${label}_STARTED"
    else
        log "BWOS_PROC_${label}_NOT_RUNNING"
    fi
}

dump_file() {
    label="$1"
    path="$2"
    if [ -f "$path" ]; then
        log "BWOS_SESSION_LOG_FILE_BEGIN ${label} ${path}"
        tail -n 160 "$path" > /dev/ttyS0 2>/dev/null || true
        log "BWOS_SESSION_LOG_FILE_END ${label}"
    else
        log "BWOS_SESSION_LOG_FILE_MISSING ${label} ${path}"
    fi
}

snapshot() {
    elapsed="$1"
    log "BWOS_HANDOFF_TRACE_BEGIN elapsed=${elapsed}"
    log "BWOS_SDDM_ACTIVE_STATE $(systemctl is-active sddm.service 2>/dev/null || true)"
    log "BWOS_SDDM_SUB_STATE $(systemctl show sddm.service -p SubState --value 2>/dev/null || true)"
    log "BWOS_SDDM_MAINPID $(systemctl show sddm.service -p MainPID --value 2>/dev/null || true)"

    if command -v loginctl >/dev/null 2>&1; then
        loginctl list-sessions --no-legend 2>/dev/null | sed 's/^/BWOS_LOGINCTL_SESSION /' > /dev/ttyS0 2>/dev/null || true
        session_id="$(loginctl list-sessions --no-legend 2>/dev/null | awk -v user="$LIVE_USER" '$3 == user { print $1; exit }' || true)"
        if [ -n "$session_id" ]; then
            loginctl show-session "$session_id" -p Name -p User -p Type -p Class -p State -p Remote -p Service -p Display -p Leader --no-pager 2>/dev/null | sed 's/^/BWOS_LOGINCTL_SHOW /' > /dev/ttyS0 2>/dev/null || true
            log "BWOS_LOGINCTL_SESSION_FOUND id=${session_id}"
        else
            log "BWOS_LOGINCTL_SESSION_MISSING user=${LIVE_USER}"
        fi
    fi

    for pid in $(pgrep -u "$LIVE_USER" -f 'systemd --user|dbus-daemon|dbus-broker|startplasma|kwin|plasmashell|ksmserver' 2>/dev/null || true); do
        tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null | sed "s/^/BWOS_USER_PROCESS pid=${pid} /" > /dev/ttyS0 2>/dev/null || true
        tr '\0' '\n' < "/proc/${pid}/environ" 2>/dev/null | grep -E '^(XDG_SESSION_TYPE|DISPLAY|WAYLAND_DISPLAY|XDG_RUNTIME_DIR|DBUS_SESSION_BUS_ADDRESS)=' | sed "s/^/BWOS_USER_ENV pid=${pid} /" > /dev/ttyS0 2>/dev/null || true
    done

    emit_process_marker KWIN_X11 kwin_x11
    emit_process_marker KWIN_WAYLAND kwin_wayland
    emit_process_marker PLASMASHELL plasmashell
    emit_process_marker KSMSERVER ksmserver
    emit_process_marker STARTPLASMA_X11 startplasma-x11
    emit_process_marker STARTPLASMA_WAYLAND startplasma-wayland
    emit_process_marker DBUS_DAEMON dbus-daemon
    emit_process_marker DBUS_BROKER dbus-broker

    if pgrep -u "$LIVE_USER" -f 'systemd --user' >/dev/null 2>&1; then
        log "BWOS_PROC_SYSTEMD_USER_STARTED"
    else
        log "BWOS_PROC_SYSTEMD_USER_NOT_RUNNING"
    fi

    ps -eo pid,user,comm,args | grep -Ei 'sddm|plasma|kwin|ksmserver|startplasma|dbus|xorg|wayland|systemd --user' | grep -v grep > /dev/ttyS0 2>&1 || true
    journalctl -b --no-pager -u sddm.service -n 120 > /dev/ttyS0 2>&1 || true
    journalctl -b --no-pager -n 220 | grep -Ei 'pam|sddm|plasma|kwin|ksmserver|startplasma|wayland|x11|xorg|dbus|xdg|bwos' > /dev/ttyS0 2>&1 || true
    log "BWOS_HANDOFF_TRACE_END elapsed=${elapsed}"
}

elapsed_total=0
for interval in 20 25 30 35; do
    sleep "$interval"
    elapsed_total=$((elapsed_total + interval))
    snapshot "$elapsed_total"
done

log "BWOS_SESSION_DIAGNOSTICS_BEGIN"
systemctl --no-pager --full status sddm.service > /dev/ttyS0 2>&1 || true
dump_file "sddm-log" /var/log/sddm.log
dump_file "xorg-log" /var/log/Xorg.0.log
dump_file "xsession-errors" /home/${LIVE_USER}/.xsession-errors
for path in /home/${LIVE_USER}/.local/share/sddm/*; do
    [ -f "$path" ] && dump_file "sddm-user" "$path"
done
log "BWOS_SESSION_DIAGNOSTICS_END"
EOF2
chmod 0755 /usr/local/bin/bwos-session-diagnostics-dump

cat > /etc/systemd/system/bwos-session-profile.service <<'EOF2'
[Unit]
Description=BWOS Session Profile Selection (SDDM Autologin)
Before=display-manager.service sddm.service
After=local-fs.target systemd-user-sessions.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/bwos-session-profile-apply
StandardOutput=journal+console
StandardError=journal+console
SyslogIdentifier=bwos-session-profile

[Install]
WantedBy=display-manager.service
EOF2

cat > /etc/systemd/system/bwos-session-diagnostics.service <<'EOF2'
[Unit]
Description=BWOS SDDM to Plasma Handoff Diagnostics
After=sddm.service graphical.target

[Service]
Type=simple
ExecStart=/usr/local/bin/bwos-session-diagnostics-dump

[Install]
WantedBy=graphical.target
EOF2

systemctl enable bwos-session-profile.service >/dev/null 2>&1 || true
systemctl enable bwos-session-diagnostics.service >/dev/null 2>&1 || true
