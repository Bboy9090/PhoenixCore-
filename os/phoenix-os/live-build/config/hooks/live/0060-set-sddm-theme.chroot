#!/bin/sh
set -eu

# Configure SDDM to use the Phoenix theme
if [ -d /usr/share/sddm/themes/phoenix ]; then
    echo "Configuring SDDM theme to phoenix..."
    mkdir -p /etc/sddm.conf.d
    cat > /etc/sddm.conf.d/phoenix.conf << EOF2
[Theme]
Current=phoenix
EOF2
fi

# Ensure the live user auto-logs into an explicit Plasma Wayland session file.
# Different Debian package layouts may provide one of several Plasma Wayland
# entry points. Resolve the first one that exists and preserve the X11 fallback.
WAYLAND_SESSION=""
for candidate in \
    /usr/share/wayland-sessions/plasmawayland.desktop \
    /usr/share/wayland-sessions/plasma.desktop \
    /usr/share/wayland-sessions/org.kde.plasma.desktop
do
    if [ -f "$candidate" ]; then
        WAYLAND_SESSION="$candidate"
        break
    fi
done

X11_SESSION=""
for candidate in \
    /usr/share/xsessions/plasmax11.desktop \
    /usr/share/xsessions/plasma.desktop
do
    if [ -f "$candidate" ]; then
        X11_SESSION="$candidate"
        break
    fi
done

if [ -z "$WAYLAND_SESSION" ]; then
    if [ -f /usr/share/xsessions/xfce.desktop ] || [ -f /usr/share/xsessions/lightdm-xsession.desktop ]; then
        echo "Info: XFCE/LightDM layout detected. Skipping SDDM configuration."
        exit 0
    fi
    echo "ERROR: No Plasma Wayland session file found for SDDM autologin" >&2
    exit 1
fi

WAYLAND_SESSION_NAME="$(basename "$WAYLAND_SESSION")"

mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/autologin.conf << EOF2
[Autologin]
User=phoenix
Session=$WAYLAND_SESSION_NAME
Relogin=true
EOF2

cat > /etc/sddm.conf.d/default-session.conf << EOF2
[General]
DefaultSession=$WAYLAND_SESSION_NAME
EOF2

# Only set theme in /etc/sddm.conf at build time.
# Autologin is configured at boot by bwos-session-profile-apply,
# which writes /etc/sddm.conf with the correct user and session.
cat > /etc/sddm.conf << EOF2
[Theme]
Current=phoenix
EOF2

if [ -n "$X11_SESSION" ]; then
    echo "Info: Plasma X11 fallback session preserved at $X11_SESSION"
fi
