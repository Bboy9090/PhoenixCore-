#!/bin/bash
set -euo pipefail

# Create a systemd service to announce graphical reach over serial.
cat <<EOF2 > /etc/systemd/system/bwos-heartbeat.service
[Unit]
Description=BWOS Graphical Heartbeat
After=graphical.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'echo "BWOS_BOOT_SUCCESS_GRAPHICAL_REACHED" > /dev/ttyS0 || true'
RemainAfterExit=yes

[Install]
WantedBy=graphical.target
EOF2

systemctl enable bwos-heartbeat.service

mkdir -p /etc/default/grub.d

# Ensure GRUB config uses .cfg extension
cat > /etc/default/grub.d/99-arcwyre.cfg <<'EOF2'
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="BWOS"
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash console=tty0 console=ttyS0,115200n8"
EOF2
