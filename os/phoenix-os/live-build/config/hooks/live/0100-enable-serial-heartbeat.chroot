#!/bin/bash
set -euo pipefail

# Create a systemd service to announce boot success over serial
cat <<EOF > /etc/systemd/system/bwos-heartbeat.service
[Unit]
Description=ARCWYRE Boot Heartbeat
After=graphical.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'echo "BWOS_BOOT_SUCCESS_GRAPHICAL_REACHED" > /dev/ttyS0 || true'
RemainAfterExit=yes

[Install]
WantedBy=graphical.target
EOF

systemctl enable bwos-heartbeat.service

mkdir -p /etc/default/grub.d

# Ensure GRUB config uses .cfg extension
cat > /etc/default/grub.d/99-arcwyre.cfg <<'EOF'
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="ARCWYRE"
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash console=tty0 console=ttyS0,115200n8"
EOF
